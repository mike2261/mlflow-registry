POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MLFLOW_BUCKET=mlflow-artifacts

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Presigned URLs from the server point at the docker-internal minio host;
# force large-file uploads and downloads through the MLflow proxy instead.
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=false
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
