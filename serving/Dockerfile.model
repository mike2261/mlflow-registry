# Thin per-model serving image.
#
#   docker build -f serving/Dockerfile.model --build-arg MODEL=kokoro-82m -t mlflow-serving/kokoro-82m .
#
# Installs serving/requirements/<MODEL>.txt (and, if present,
# serving/requirements/<MODEL>.nodeps.txt with --no-deps for packages whose
# declared dependencies would drag in a different torch), then this repo's
# package so the pyfunc wrapper classes are importable. At runtime the
# container serves models:/<MODEL>@serving straight from the registry.

ARG BASE_IMAGE=mlflow-serving-base:latest
FROM ${BASE_IMAGE}

ARG MODEL
RUN test -n "${MODEL}" || (echo "build-arg MODEL is required" && exit 1)

WORKDIR /build
COPY serving/requirements/${MODEL}*.txt ./
RUN pip install -r "${MODEL}.txt" \
    && if [ -f "${MODEL}.nodeps.txt" ]; then pip install --no-deps -r "${MODEL}.nodeps.txt"; fi

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-deps .

WORKDIR /app
ENV MODEL_CACHE=/models \
    HF_HOME=/models/.hf \
    MLFLOW_SCORING_SERVER_REQUEST_TIMEOUT=600 \
    MLFLOW_DISABLE_AGENT_HINT=1 \
    SERVING_MODEL_URI=models:/${MODEL}@serving

EXPOSE 8080
CMD mlflow models serve -m "${SERVING_MODEL_URI}" --host 0.0.0.0 --port 8080 --env-manager local --workers 1
