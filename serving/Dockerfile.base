# Shared base for every serving image: CUDA runtime, Python 3.12, the audio
# system libraries, torch/torchaudio on one pinned CUDA wheel index, and mlflow.
#
# Build once:  scripts/serve.sh build-base
# Per-model images start FROM mlflow-serving-base:latest (see Dockerfile.model).
#
# Everything model-specific (transformers pins, nemo, sherpa-onnx, ...) lives in
# serving/requirements/<model>.txt because the pins conflict across models.
# A pip constraints file freezes torch so no per-model install can silently
# swap the CUDA build.

ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
FROM ${CUDA_IMAGE}

ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
ARG TORCH_VERSION=2.8.0
ARG MLFLOW_VERSION=3.16.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip \
        build-essential git curl ca-certificates \
        ffmpeg libsndfile1 sox espeak-ng \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
RUN pip install --upgrade pip setuptools wheel

# torch first, from the CUDA-specific index, then pin it for every later install.
RUN pip install --index-url ${TORCH_INDEX_URL} \
        torch==${TORCH_VERSION} torchaudio==${TORCH_VERSION} \
    && printf 'torch==%s\ntorchaudio==%s\n' "${TORCH_VERSION}" "${TORCH_VERSION}" > /opt/constraints.txt
ENV PIP_CONSTRAINT=/opt/constraints.txt

RUN pip install "mlflow==${MLFLOW_VERSION}" numpy scipy soundfile

WORKDIR /app
